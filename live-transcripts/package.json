{
  "name": "teams-live-transcript-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "teams-transcript": "./dist/src/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm test",
    "cli": "tsx src/cli/main.ts",
    "dump-raw-captions": "tsx src/cli/dumpRawCaptions.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "playwright-core": "^1.60.0"
  }
}
